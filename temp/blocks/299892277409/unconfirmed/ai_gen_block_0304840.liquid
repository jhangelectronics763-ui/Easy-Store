{% doc %}
  @prompt
    Create a professional responsive Mini Website Widget for Easy Store Pakistan, matching its existing green branding. Use a compact floating green rounded pill with an app icon and editable 'Get the App' text, smooth shadow, and a separate small black circular close button with a white ✖ immediately beside it. Default bottom-left; support bottom-right, adjustable bottom/side spacing, mobile safe areas, and avoid overlap with cart, WhatsApp, chat, or other floating controls where detectable. Clicking the pill opens a configurable app download URL; if unset, display an editable fallback message instead of a broken link. Closing hides immediately and persists for the current browser session. Provide an editor setting to reset/re-enable visibility after dismissal, explaining its scope if browser session state cannot be reset centrally. Group merchant-editable controls as 'Mini Website Widget': enabled, button label, app icon image picker, download URL, background/text colors, left/right position, bottom/side spacing, desktop/mobile/both visibility, and visibility on homepage and product pages. Use accessible keyboard controls and reduced-motion-friendly styling. Settings should be in the theme editor, not a separate Shopify admin app/dashboard. Make available site-wide where supported; do not claim a single-template block automatically appears across all pages.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% liquid
  assign show_widget = block.settings.enabled
  if block.settings.page_visibility == 'home' and request.page_type != 'index'
    assign show_widget = false
  elsif block.settings.page_visibility == 'product' and request.page_type != 'product'
    assign show_widget = false
  endif
%}
{% style %}
  .ai-mini-widget-{{ ai_gen_id }} { display:block; position:fixed; z-index:40; bottom:calc({{ block.settings.bottom_spacing }}px + env(safe-area-inset-bottom, 0px)); {% if block.settings.position == 'left' %}left:calc({{ block.settings.side_spacing }}px + env(safe-area-inset-left, 0px));{% else %}right:calc({{ block.settings.side_spacing }}px + env(safe-area-inset-right, 0px));{% endif %} width:100%; max-width:calc(100vw - 32px); font-family:inherit; color:{{ block.settings.text_color }}; }
  .ai-mini-widget-{{ ai_gen_id }}[hidden] { display:none; }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__row { display:flex; align-items:center; gap:8px; {% if block.settings.position == 'right' %}flex-direction:row-reverse;{% endif %} }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__pill { display:inline-flex; align-items:center; justify-content:center; gap:10px; min-height:48px; max-width:100%; padding:10px 17px; border:0; border-radius:999px; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; box-shadow:0 5px 18px rgba(0,0,0,.22); font:inherit; font-size:15px; font-weight:700; line-height:1.2; text-decoration:none; cursor:pointer; transition:box-shadow 160ms ease,filter 160ms ease; }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__pill:hover { filter:brightness(.94); box-shadow:0 7px 22px rgba(0,0,0,.27); }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__pill:focus-visible,.ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__close:focus-visible { outline:3px solid #111; outline-offset:3px; }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__icon,.ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__placeholder { display:block; width:25px; height:25px; flex:0 0 25px; object-fit:contain; border-radius:5px; }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__placeholder { padding:3px; background:rgba(255,255,255,.18); }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__placeholder svg { width:100%; height:100%; fill:currentColor; }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__close { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; flex:0 0 28px; padding:0; border:0; border-radius:50%; background:#111; color:#fff; font:inherit; font-size:15px; line-height:1; cursor:pointer; }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__message { display:none; max-width:min(280px,calc(100vw - 32px)); margin:0 0 8px; padding:10px 14px; border-radius:10px; background:#111; color:#fff; box-shadow:0 4px 14px rgba(0,0,0,.2); font-size:14px; line-height:1.4; }
  .ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__message.is-visible { display:block; }
  {% unless block.settings.device_visibility == 'both' %}{% if block.settings.device_visibility == 'mobile' %}@media (min-width:750px){.ai-mini-widget-{{ ai_gen_id }}{display:none!important;}}{% else %}@media (max-width:749px){.ai-mini-widget-{{ ai_gen_id }}{display:none!important;}}{% endif %}{% endunless %}
  @media(prefers-reduced-motion:reduce){.ai-mini-widget-{{ ai_gen_id }} .ai-mini-widget__pill{transition:none;}}
{% endstyle %}
<mini-website-widget-{{ ai_gen_id }} class="ai-mini-widget-{{ ai_gen_id }}" data-position="{{ block.settings.position }}" {% unless show_widget %}hidden{% endunless %} {{ block.shopify_attributes }}>
  <p class="ai-mini-widget__message" role="status" aria-live="polite">{{ block.settings.fallback_message | escape }}</p>
  <div class="ai-mini-widget__row">
    {% if block.settings.download_url != blank %}<a class="ai-mini-widget__pill" href="{{ block.settings.download_url }}" target="_blank" rel="noopener noreferrer">{% else %}<button class="ai-mini-widget__pill" type="button" aria-expanded="false">{% endif %}
      {% if block.settings.app_icon %}<img class="ai-mini-widget__icon" src="{{ block.settings.app_icon | image_url: width: 100 }}" alt="" width="25" height="25" loading="lazy">{% else %}<span class="ai-mini-widget__placeholder" aria-hidden="true">{{ 'image' | placeholder_svg_tag }}</span>{% endif %}<span>{{ block.settings.button_label | escape }}</span>
    {% if block.settings.download_url != blank %}</a>{% else %}</button>{% endif %}
    <button class="ai-mini-widget__close" type="button" aria-label="Close app widget">✖</button>
  </div>
</mini-website-widget-{{ ai_gen_id }}>
<script>
(function(){const tagName='mini-website-widget-{{ ai_gen_id }}';if(customElements.get(tagName))return;class MiniWebsiteWidget extends HTMLElement{connectedCallback(){this.storageKey='mini-widget-dismissed-{{ ai_gen_id }}';if({{ block.settings.reset_visibility | json }}){try{sessionStorage.removeItem(this.storageKey)}catch(error){}}try{if(sessionStorage.getItem(this.storageKey)==='true')this.hidden=true}catch(error){}this.closeButton=this.querySelector('.ai-mini-widget__close');this.pill=this.querySelector('.ai-mini-widget__pill');this.message=this.querySelector('.ai-mini-widget__message');this.closeButton.addEventListener('click',()=>{this.hidden=true;try{sessionStorage.setItem(this.storageKey,'true')}catch(error){}});if(this.pill.tagName==='BUTTON')this.pill.addEventListener('click',()=>{const visible=this.message.classList.toggle('is-visible');this.pill.setAttribute('aria-expanded',String(visible))});this.adjustForFloatingControls();this.resizeObserver=new ResizeObserver(()=>this.adjustForFloatingControls());this.resizeObserver.observe(document.documentElement)}disconnectedCallback(){if(this.resizeObserver)this.resizeObserver.disconnect()}adjustForFloatingControls(){if(this.hidden||!this.isConnected)return;const side=this.dataset.position;const patterns=/whatsapp|chat|cart|support|messenger|intercom|crisp|tawk/i;let lift=0;document.querySelectorAll('a,button,[role="button"],iframe,div').forEach(element=>{if(element===this||this.contains(element)||!patterns.test((element.id||'')+' '+(typeof element.className==='string'?element.className:'')+' '+(element.getAttribute('aria-label')||'')))return;const rect=element.getBoundingClientRect();if(getComputedStyle(element).position!=='fixed'||rect.width<20||rect.height<20||rect.bottom<innerHeight-180)return;const inCorner=side==='left'?rect.left<innerWidth*.45:rect.right>innerWidth*.55;if(inCorner&&rect.bottom>innerHeight-160)lift=Math.max(lift,innerHeight-rect.top+12)});this.style.setProperty('--ai-mini-widget-lift',lift+'px');this.style.bottom='calc({{ block.settings.bottom_spacing }}px + env(safe-area-inset-bottom, 0px) + var(--ai-mini-widget-lift, 0px))'}}customElements.define(tagName,MiniWebsiteWidget)})();
</script>
{% schema %}
{"name":"Mini Website Widget","settings":[{"type":"header","content":"Mini Website Widget"},{"type":"checkbox","id":"enabled","label":"Enable widget","default":true},{"type":"checkbox","id":"reset_visibility","label":"Re-enable after dismissal","default":false},{"type":"paragraph","content":"Reset takes effect when the page loads in this browser; it cannot clear session state on visitors’ devices centrally."},{"type":"text","id":"button_label","label":"Button label","default":"Get the App"},{"type":"image_picker","id":"app_icon","label":"App icon"},{"type":"url","id":"download_url","label":"Download URL"},{"type":"text","id":"fallback_message","label":"Fallback message","default":"App download link coming soon."},{"type":"color","id":"background_color","label":"Background","default":"#0B5D2A"},{"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},{"type":"select","id":"position","label":"Position","options":[{"value":"left","label":"Bottom-left"},{"value":"right","label":"Bottom-right"}],"default":"left"},{"type":"range","id":"bottom_spacing","label":"Bottom spacing","min":0,"max":100,"step":5,"unit":"px","default":25},{"type":"range","id":"side_spacing","label":"Side spacing","min":0,"max":100,"step":5,"unit":"px","default":20},{"type":"select","id":"device_visibility","label":"Device visibility","options":[{"value":"both","label":"Desktop and mobile"},{"value":"desktop","label":"Desktop only"},{"value":"mobile","label":"Mobile only"}],"default":"both"},{"type":"select","id":"page_visibility","label":"Show on","options":[{"value":"all","label":"All pages"},{"value":"home","label":"Homepage only"},{"value":"product","label":"Product pages only"}],"default":"all"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Mini Website Widget"}],"tag":null,"class":"mini-website-widget-block"}
{% endschema %}