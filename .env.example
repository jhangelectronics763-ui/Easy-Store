# Copy to .env and change the values before running docker compose
POSTGRES_PASSWORD=change_me_db_password
ODOO_ADMIN_PASSWORD=change_me_admin_password
DOMAIN=www.easystore.example

# EasyStore Node server (node server.js)
PORT=3000
# Used only the first time the server starts. Change it later in admin.html > Settings.
ADMIN_PASSWORD=change_me_strong_password

# Optional persistent storage paths (set these to subfolders on a mounted Render Disk)
EASYSTORE_DATA_DIR=/var/data/data
EASYSTORE_UPLOADS_DIR=/var/data/uploads
EASYSTORE_BACKUPS_DIR=/var/data/backups
