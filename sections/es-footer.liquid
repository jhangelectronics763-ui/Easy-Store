<footer class="es-footer"><div class="es-footer-grid"><div><a class="es-footer-brand" href="{{ routes.root_url }}">{{ shop.name | default: 'Easy Store' }}</a><p>Everyday essentials, electronics, fashion and more — all in one place.</p></div><div><strong>Shop</strong><a href="{{ routes.all_products_collection_url }}">All products</a><a href="{{ routes.collections_url }}">Collections</a><a href="{{ routes.search_url }}">Search</a></div><div><strong>Customer care</strong>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}<a href="{{ routes.account_url }}">My account</a></div></div><div class="es-footer-bottom">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved. Prices shown in {{ cart.currency.iso_code | default: shop.currency }}.</div></footer>
{% schema %}{"name":"Easy Store footer","settings":[{"type":"link_list","id":"menu","label":"Footer menu"}]}{% endschema %}