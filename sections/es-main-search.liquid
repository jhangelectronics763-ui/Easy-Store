<section class="es-section"><h1>Search</h1><form class="es-search" action="{{ routes.search_url }}" method="get"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search products"><button type="submit">Search</button></form>{% if search.performed %}<p>Results for “{{ search.terms | escape }}”</p><div class="es-products">{% for item in search.results %}{% if item.object_type == 'product' %}<article class="es-product"><a class="es-product-image" href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}</a><div class="es-product-info"><a class="es-product-title" href="{{ item.url }}">{{ item.title | escape }}</a><div class="es-price">{{ item.price | money }}</div></div></article>{% endif %}{% else %}<p>No matching products found.</p>{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Main search","settings":[]} {% endschema %}