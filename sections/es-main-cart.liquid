<section class="es-section es-cart"><h1>Your cart</h1>{% if cart.item_count == 0 %}<p>Your cart is currently empty.</p><a class="es-button" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="es-cart-items">{% for item in cart.items %}<div class="es-cart-item"><a href="{{ item.url }}">{{ item.image | image_url: width: 180 | image_tag: alt: item.product.title }}</a><div><a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a><p>{{ item.final_price | money }}</p><label for="updates_{{ item.key }}">Quantity</label><input id="updates_{{ item.key }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"><a href="{{ item.url_to_remove }}">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><p class="es-cart-total">Subtotal: {{ cart.total_price | money }}</p><p>Shipping and discounts calculated at checkout.</p><button class="es-button" type="submit" name="update">Update cart</button><button class="es-button" type="submit" name="checkout">Checkout</button></form>{% endif %}</section>{% schema %}{"name":"Main cart","settings":[]} {% endschema %}