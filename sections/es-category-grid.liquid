<section class="es-section es-category-section">
  <div class="es-section-head"><div><span class="es-eyebrow">FIND YOUR FAVOURITES</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div></div>
  <div class="es-category-grid">
    {% for block in section.blocks %}
      {% assign category_collection = block.settings.collection %}
      {% if category_collection != blank %}
        <a class="es-category-card" href="{{ category_collection.url }}" {{ block.shopify_attributes }}>
          <span class="es-category-image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title | default: category_collection.title }}{% elsif category_collection.featured_image != blank %}{{ category_collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: category_collection.title }}{% else %}<span class="es-category-placeholder">ES</span>{% endif %}</span>
          <span class="es-category-name">{{ block.settings.title | default: category_collection.title | escape }}</span>
          <span class="es-category-link">Explore collection →</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Shop by category",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Shop by category"},
    {"type":"text","id":"description","label":"Description","default":"Explore our most-loved categories"}
  ],
  "blocks": [
    {"type":"category","name":"Category","settings":[
      {"type":"text","id":"title","label":"Category title"},
      {"type":"collection","id":"collection","label":"Collection"},
      {"type":"image_picker","id":"image","label":"Category image"}
    ]}
  ],
  "max_blocks": 12,
  "presets": [{"name":"Shop by category","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]
}
{% endschema %}