<section class="es-section"><div class="es-section-head"><div><span class="es-eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.collection != blank %}<a class="es-text-link" href="{{ section.settings.collection.url }}">View all →</a>{% endif %}</div>{% assign chosen_collection = section.settings.collection %}<div class="es-products">{% if chosen_collection != blank %}{% for product in chosen_collection.products limit: section.settings.limit %}<article class="es-product"><a href="{{ product.url }}" class="es-product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{% else %}<span>No image</span>{% endif %}</a><div class="es-product-info"><a class="es-product-title" href="{{ product.url }}">{{ product.title | escape }}</a><div class="es-price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% form 'product', product, class: 'es-quick-add' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}</div></article>{% endfor %}{% else %}<p>Select a collection in the theme editor to show your products here.</p>{% endif %}</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"HAND-PICKED FOR YOU"},{"type":"text","id":"heading","label":"Heading","default":"Popular right now"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products to show","min":2,"max":12,"step":1,"default":4}],"presets":[{"name":"Featured products"}]}{% endschema %}