<section class="es-section"><h1>Shop by category</h1><div class="es-products">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<article class="es-product"><a class="es-product-image" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}<span>Explore collection</span>{% endif %}</a><div class="es-product-info"><a class="es-product-title" href="{{ collection.url }}">{{ collection.title | escape }}</a></div></article>{% endunless %}{% endfor %}</div></section>{% schema %}{"name":"All collections","settings":[]} {% endschema %}