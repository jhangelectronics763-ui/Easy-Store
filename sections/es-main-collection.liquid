<section class="es-section es-collection"><div class="es-section-head"><div><span class="es-eyebrow">EASY STORE COLLECTION</span><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="es-description">{{ collection.description }}</div>{% endif %}</div></div>{% paginate collection.products by 24 %}<div class="es-products">{% for product in collection.products %}<article class="es-product"><a href="{{ product.url }}" class="es-product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</a><div class="es-product-info"><a class="es-product-title" href="{{ product.url }}">{{ product.title | escape }}</a><div class="es-price">{{ product.price | money }}</div><a class="es-button" href="{{ product.url }}">View product</a></div></article>{% else %}<p>No products in this collection yet.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="es-pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</section>{% schema %}{"name":"Main collection","settings":[]} {% endschema %}